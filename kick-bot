const {
  Client,
  GatewayIntentBits,
  Events,
  EmbedBuilder,
} = require("discord.js");

const express = require("express");

// =======================
// 設定
// =======================
const TOKEN = process.env.TOKEN;

const WATCH_CHANNEL_ID = "1540932243826942002";

// グレー＋青系の左ラインカラー
const EMBED_COLOR = 0x6f8fa6;

// =======================
// Discord Bot
// =======================
const client = new Client({
  intents: [
    GatewayIntentBits.Guilds,
    GatewayIntentBits.GuildMessages,
    GatewayIntentBits.GuildMembers,
    GatewayIntentBits.MessageContent,
  ],
});

// =======================
// Webサーバー（Render用）
// =======================
const app = express();

app.get("/", (req, res) => {
  res.send("Bot is alive!");
});

const PORT = process.env.PORT || 3000;

app.listen(PORT, () => {
  console.log(`Web server running on port ${PORT}`);
});

// =======================
// メッセージ監視＆キック
// =======================
client.on(Events.MessageCreate, async (message) => {
  try {
    if (!message.guild) return;
    if (message.author.bot) return;

    if (message.channel.id !== WATCH_CHANNEL_ID) return;

    const member = await message.guild.members.fetch(message.author.id);

    // 警告Embed
    const embed = new EmbedBuilder()
      .setColor(EMBED_COLOR)
      .setTitle("🚨 Anti-Spam Detection Channel")
      .setDescription(
        "このチャンネルにメッセージを送信しないでください\n" +
        "このチャンネルはスパムボットを検知するために使用されます。\n" +
        "メッセージを送信したユーザーは即座にキックされます。\n\n" +
        "DO NOT SEND MESSAGES IN THIS CHANNEL\n" +
        "This channel is used to detect spam bots. Any user who sends a message here will be kicked immediately."
      )
      .setFooter({ text: "Auto Moderation System" });

    await message.channel.send({ embeds: [embed] });

    // キック
    await member.kick("Sent message in anti-spam detection channel");

  } catch (err) {
    console.error("Error:", err);
  }
});

// =======================
// 起動ログ
// =======================
client.once(Events.ClientReady, (c) => {
  console.log(`Logged in as ${c.user.tag}`);
});

client.login(TOKEN);
